# Copy to .env and fill in. .env is gitignored.
# Values already exported in your shell take precedence over this file.

# --- Solana key. Base58 secret key, or a path to a keypair JSON (~/.config/solana/id.json) ---
# Bridging FROM Solana it holds the USDC being burned.
# Bridging TO Solana it relays the mint and pays the fee plus the used-nonce rent.
SOLANA_SECRET_KEY=
SOLANA_KEYPAIR_FILE=

# --- Stellar key. Same names portfolio.mjs already uses ---
# Bridging TO Stellar it only relays the mint and pays the XLM fee, so a throwaway is fine.
# Bridging FROM Stellar it is the account whose USDC gets burned.
STELLAR_SECRET_KEY=
STELLAR_SECRET_KEY_FILE=

# --- Where the USDC lands. G... account (needs a USDC trustline) or C... contract ---
STELLAR_RECIPIENT=
# Where the USDC lands on Solana when bridging back (--from stellar).
# A wallet address whose USDC token account already exists. Defaults to the SOLANA_SECRET_KEY wallet.
SOLANA_RECIPIENT=

# --- Endpoints. Defaults are the public ones; a private Solana RPC is worth having ---
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
STELLAR_RPC_URL=https://mainnet.sorobanrpc.com
HORIZON_URL=https://horizon.stellar.org
IRIS_API_URL=https://iris-api.circle.com

# --- Optional fee tuning ---
# Solana priority fee, micro-lamports per compute unit. 0 is usually fine.
SOLANA_PRIORITY_FEE_MICROLAMPORTS=0
# Stellar inclusion fee in stroops, before the Soroban resource fee is added.
STELLAR_BASE_FEE=10000
